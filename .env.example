# MadeBy environment — copy to .env and fill in.
# This file doubles as the provisioning handoff (see issue #7 / OPERATIONS.md §4).
# Nothing here is required to typecheck/build the skeleton; it's needed to run against real services.

# --- Database: Neon Postgres + pgvector (OPERATIONS.md §4/§5) ---
DATABASE_URL=

# --- Auth: GitHub OAuth (the code-first wedge) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App: on-demand repo ingestion (#10) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- Cloudflare: CDN + R2 (zero-egress object storage) + badge Worker ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Modal: cold-path compute (ingestion / fingerprinting / classification) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Observability ---
SENTRY_DSN=
AXIOM_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
