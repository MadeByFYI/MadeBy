# MadeBy environment — copy to .env and fill in.
# Nothing here is required to typecheck/build the skeleton; it's needed to run against real services.

# --- Database (Postgres + pgvector) ---
DATABASE_URL=

# --- Auth: GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App: on-demand repo ingestion (#10) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- Object storage + CDN + badge Worker ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Cold-path compute (ingestion / fingerprinting / classification) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Observability ---
SENTRY_DSN=
AXIOM_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
