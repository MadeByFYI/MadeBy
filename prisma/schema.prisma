// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())

  @@unique([identifier, token])
}

// Application models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts Account[]
  sessions Session[]
  contents Content[]
  identity Identity?
}

model Content {
  id            String      @id @default(cuid())
  title         String
  description   String?
  contentType   ContentType
  creatorName   String
  originalUrl   String?
  thumbnailUrl  String?
  attribution   String?     @db.Text
  collaborators String?     @db.Text // JSON array
  aiToolsUsed   String?     @db.Text // JSON array
  owner         String?     // Name or @handle of content owner
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum ContentType {
  HUMAN
  AI
  WITH_AI
}

// Identity enums
enum IdentityType {
  INDIVIDUAL
  CORPORATE
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

// Identity model - public profile for users
model Identity {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  identityType IdentityType @default(INDIVIDUAL)
  handle       String?      @unique // URL slug: alphanumeric + hyphens
  displayName  String?
  bio          String?      @db.Text
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Related collections
  mailingAddress MailingAddress?
  emails         IdentityEmail[]
  phones         IdentityPhone[]
  domains        IdentityDomain[]

  @@index([handle])
}

// Mailing address (one per identity)
model MailingAddress {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  street1    String
  street2    String?
  city       String
  state      String?
  postalCode String
  country    String

  visibility       Visibility         @default(PRIVATE)
  verified         VerificationStatus @default(UNVERIFIED)
  verificationCode String?
  verificationSentAt DateTime?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Email addresses (multiple per identity)
model IdentityEmail {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  email     String
  isPrimary Boolean @default(false)

  visibility         Visibility         @default(PRIVATE)
  verified           VerificationStatus @default(UNVERIFIED)
  verificationToken  String?            @unique
  verificationSentAt DateTime?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityId, email])
  @@index([verificationToken])
}

// Phone numbers (multiple per identity)
model IdentityPhone {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  phone     String // E.164 format: +1234567890
  isPrimary Boolean @default(false)

  visibility           Visibility         @default(PRIVATE)
  verified             VerificationStatus @default(UNVERIFIED)
  verificationCode     String?
  verificationSentAt   DateTime?
  verificationAttempts Int                @default(0)
  verifiedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityId, phone])
}

// Domains (multiple per identity)
model IdentityDomain {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  domain String // e.g., "example.com"

  visibility         Visibility         @default(PUBLIC)
  verified           VerificationStatus @default(UNVERIFIED)
  verificationToken  String?
  verificationSentAt DateTime?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityId, domain])
  @@index([domain])
}
