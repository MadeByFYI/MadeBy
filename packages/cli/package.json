{
  "name": "madeby",
  "version": "0.3.1",
  "description": "Disclose AI authorship of code. `npx madeby ai` adds an Authored-by-ai git trailer; AI coding agents disclose per the ACO standard (human/with_ai/ai) from an AGENTS.md convention. Disclosure, not detection. Gate PRs with `madeby check`.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "The Registrar"
  },
  "contributors": [
    "Claude, Anthropic (AI-assisted — see the Co-Authored-By trailers in the git history)"
  ],
  "homepage": "https://github.com/MadeByFYI/MadeBy/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadeByFYI/MadeBy.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ai-authorship",
    "ai-disclosure",
    "authored-by-ai",
    "ai-attribution",
    "ai-provenance",
    "ai-generated-code",
    "coding-agent",
    "agents",
    "agents-md",
    "aco",
    "co-authored-by",
    "provenance",
    "disclosure",
    "attestation",
    "dco",
    "pull-request",
    "ci",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "madeby": "./dist/madeby.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/madeby.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/madeby.mjs --banner:js='#!/usr/bin/env node' && chmod +x dist/madeby.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@madeby/analyzer": "workspace:*",
    "@madeby/core": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
