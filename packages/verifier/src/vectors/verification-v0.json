        "carrier": "in-toto",
        "_type": "https://in-toto.io/Statement/v1",
        "predicateType": "https://madeby.fyi/attestation/v0",
        "subject": [
          {
            "digest": {
              "sha256": "2b1bce86a0f9e60a5bbdea9447288bc62d7191ff249e562a82f89a2847faf4c8"
            }
          }
        ],
        "predicate": {
          "subject": {
            "algorithm": "sha256",
            "target": "FILE",
            "value": "2b1bce86a0f9e60a5bbdea9447288bc62d7191ff249e562a82f89a2847faf4c8"
          },
          "attribution": {
            "identityId": "did:web:alice.example",
            "role": "creator"
          },
          "assertedTier": "bound",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "signatures": [
          {
            "signerKeyId": "430a77822da381e811654901f1d8f195f6a9a5f2d7c4999b6d962f9da193cc11",
            "value": "9d0336d37649d9efc94f3f1c2b8da667ee2883e76891f8d6f5f90c73a56f85b639e5a577834b9e6fb5664a5661679bc7474f62e78a9422ad3a7b1448ec427606",
            "carrierId": "in-toto",
            "signedAt": "2026-01-01T00:00:00Z"
          }
        ]
      },
      "verify": {
        "trustSigner": true,
        "withContent": true
      },
      "expect": {
        "signatureValid": true,
        "recognizedCarrier": true,
        "subjectIsNative": true,
        "subjectIsExact": true,
        "contentMatches": true,
        "confirmedTier": "bound"
      }
    },
