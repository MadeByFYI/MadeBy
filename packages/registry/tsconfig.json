{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // @madeby/core's source uses Web platform globals (TextEncoder/crypto); since we consume
    // it as source, our tsc deep-checks those files and needs the DOM lib too.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src"]
}
